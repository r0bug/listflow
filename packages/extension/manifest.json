{
  "manifest_version": 3,
  "name": "listflow",
  "version": "1.0.0",
  "description": "YF eBay suite front door: comps research, AI-identified items, draft autofill with SKU|LOC labels, draft resume, sale detection.",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "alarms"],
  "host_permissions": [
    "https://www.ebay.com/*",
    "https://www.worthpoint.com/*",
    "http://localhost:3005/*",
    "https://list.robug.com/*",
    "https://listflow.robug.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ebay.com/sch/*"],
      "js": ["lib/api.js", "content-sold.js", "comptool-sold.js"],
      "css": ["comptool.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ebay.com/seller/*",
        "https://www.ebay.com/usr/*",
        "https://www.ebay.com/str/*"
      ],
      "js": ["lib/api.js", "comptool-sold.js"],
      "css": ["comptool.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.ebay.com/sh/research*"],
      "js": ["lib/api.js", "comptool-terapeak.js"],
      "css": ["comptool.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.worthpoint.com/inventory/search*"],
      "js": ["lib/api.js", "comptool-worthpoint.js"],
      "css": ["comptool.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.ebay.com/itm/*"],
      "js": ["lib/api.js", "content-detail.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ebay.com/sl/sell*",
        "https://www.ebay.com/lstng*"
      ],
      "js": ["lib/api.js", "content-listing.js", "content-draft.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.ebay.com/sh/lst/drafts*"],
      "js": ["lib/api.js", "content-drafts-list.js"],
      "run_at": "document_idle"
    }
  ]
}
