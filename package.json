{
  "name": "listflow",
  "version": "2.0.0-alpha",
  "private": true,
  "description": "YF unified eBay suite: ingest → group → identify → comps → draft → sale ledger",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @listflow/server",
    "dev:watcher": "npm run dev -w @listflow/watcher",
    "dev:app": "npm run dev -w @listflow/app",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "prisma": "^6.15.0"
  }
}
